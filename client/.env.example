# ─────────────────────────────────────────────────────────────────────────────
# Copy to client/.env.local for development, or client/.env.production for a
# build. Never commit a filled-in file. Everything here is bundled into the
# JavaScript that ships to browsers — put no secrets in it.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────────────────────
# Leave blank in development to use the Vite dev-server proxy (vite.config.js).
# In production, set the full origin of the API, e.g. https://api.example.com
VITE_API_URL=

# ── Branding ─────────────────────────────────────────────────────────────────
VITE_SITE_NAME=SkillHub
VITE_SITE_LEGAL=the SkillHub platform
VITE_SITE_URL=https://skillhub.example.com
VITE_SITE_TAGLINE=Local Skills Marketplace
VITE_SUPPORT_EMAIL=support@skillhub.example.com
VITE_CONTACT_EMAIL=hello@skillhub.example.com
VITE_TWITTER_HANDLE=@skillhub
VITE_OG_IMAGE=

# Optional looping hero video on the landing page. Hidden when blank.
VITE_HERO_VIDEO_URL=

# ── Locale & jurisdiction ────────────────────────────────────────────────────
VITE_SERVICE_AREA=your area
VITE_COUNTRY=the Republic of Example
VITE_LEGAL_ADDRESS=1 Example Street, Example City
VITE_DEFAULT_CURRENCY=USD
# ISO 3166-1 alpha-2 code emitted in schema.org PostalAddress markup.
VITE_COUNTRY_CODE=US
# IANA time zone for rendering dates. Blank = each visitor's own time zone.
VITE_TIMEZONE=
# BCP-47 tag for date/time formatting. Blank = each visitor's own locale.
VITE_DATE_LOCALE=

# ── Payments — Stripe (optional) ─────────────────────────────────────────────
# Publishable key only (pk_test_… / pk_live_…). Never the secret key.
VITE_STRIPE_PUBLISHABLE_KEY=
