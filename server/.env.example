# ─────────────────────────────────────────────────────────────────────────────
# Copy to server/.env and fill in. Never commit the filled-in file.
# Only MONGO_URI, JWT_SECRET and JWT_REFRESH_SECRET are required to boot;
# every integration below degrades gracefully when left blank.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────────────────────
PORT=5000
MONGO_URI=mongodb://localhost:27017/skillhub
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── URLs ─────────────────────────────────────────────────────────────────────
# Where the frontend is served. Used in password-reset links, e-mail bodies and
# as an allowed CORS origin.
CLIENT_URL=http://localhost:5173
# Public base URL of this API — used to build absolute image URLs in SSR previews.
API_URL=http://localhost:5000
# Extra browser origins allowed to call the API (comma-separated).
ALLOWED_ORIGINS=

# ── Branding ─────────────────────────────────────────────────────────────────
SITE_NAME=SkillHub
SUPPORT_EMAIL=support@skillhub.example.com

# ── Locale ───────────────────────────────────────────────────────────────────
# ISO-4217 code used when a price carries no currency of its own.
DEFAULT_CURRENCY=USD
# Human-readable service area, used in generated page titles.
SERVICE_AREA=your area
# BCP-47 tag used to format dates and times in e-mail and SMS bodies.
DATE_LOCALE=en-US
# Dialling code without '+' and the length of a national subscriber number.
PHONE_COUNTRY_CODE=1
PHONE_NATIONAL_DIGITS=10

# ── Image uploads — Cloudinary (optional) ────────────────────────────────────
# Leave blank to fall back to local disk storage under server/uploads/.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=skillhub

# ── Payments — Stripe (optional) ─────────────────────────────────────────────
# Without these, checkout endpoints return an error but the rest of the app runs.
# Use test keys (sk_test_…) during development.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:5000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=

# ── Video rooms — LiveKit (optional) ─────────────────────────────────────────
# Required only for live classes and video consultations.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# ── Transactional e-mail — SMTP (optional) ───────────────────────────────────
# Unset: e-mails are printed to the console instead of being sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Transactional SMS (optional) ─────────────────────────────────────────────
# Any gateway accepting { api_token, recipient, sender_id, type, message }.
# Unset: messages are logged to the console instead of being sent.
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER_ID=SkillHub

# ── Seeding (optional) ───────────────────────────────────────────────────────
# Used by `npm run seed:images` to pull category cover photos.
UNSPLASH_ACCESS_KEY=
